# Groq API key (OPTIONAL). Heuristic intent detection works without it.
# Set as a Render secret for natural-language mode — never commit the real key.
GROQ_API_KEY=

# Comma-separated list of allowed frontend origins (Vercel URL in production, local Vite in dev).
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: override the Groq model used for intent classification / order extraction.
# GROQ_MODEL=llama-3.1-8b-instant
